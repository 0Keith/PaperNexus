{
    "navigationFallback": {
        "rewrite": "/index.html"
    },
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
    },
    "mimeTypes": {
        ".json": "application/json",
        ".png": "image/png",
        ".ico": "image/x-icon"
    }
}
