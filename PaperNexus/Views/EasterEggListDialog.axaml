<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:PaperNexus.Views"
        x:Class="PaperNexus.Views.EasterEggListDialog"
        Title="Secrets"
        Icon="avares://PaperNexus/Assets/logo.png"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#2B2B2B">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="SECRETS" FontSize="16" FontWeight="Bold" LetterSpacing="3"
                       Foreground="#FFD93D"/>
            <TextBlock Text="Hidden things scattered through the app. Find them all."
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress reads at a glance: a count plus a chunky pixel-style bar that matches
             the overlay's arcade styling. -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,16,0,12">
            <TextBlock x:Name="ProgressText" Text="0 / 0 found"
                       FontSize="12" FontWeight="Bold" Foreground="#8BE9FD" LetterSpacing="1"/>
            <Border Background="#1E1E1E" BorderBrush="#3A3A3E" BorderThickness="2" Height="14">
                <Rectangle x:Name="ProgressBar" Fill="#FFD93D"
                           HorizontalAlignment="Left" Width="0"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="EggList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="v:EasterEggListItem">
                        <Border Background="#1E1E1E" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,12,*">
                                <!-- A filled box for found, an empty one for still hidden. -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Mark}"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding MarkColor}"/>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{Binding NameColor}"/>
                                    <TextBlock Text="{Binding Hint}"
                                               FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Close"
                x:Name="CloseButton"
                Click="OnCloseClicked"
                ToolTip.Tip="Close the secrets list"
                HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,6"/>
    </Grid>
</Window>
